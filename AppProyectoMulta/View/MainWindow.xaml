<Window x:Class="AppProyectoMulta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Multas" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/logo.ico"
        Background="#FF0D1B2A">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF112D4E">
            <TextBlock Text="Sistema de Gestión de Multas"
                       Foreground="White"
                       FontSize="22"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="20">
                <Image Source="/img/logo.png"
                       Stretch="Uniform" 
                       Opacity="0.8"/>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="15,0,15,0">

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">

                    <Button Content="Municipios" Width="200" Height="45" Margin="0,10,0,0"
                            Background="#FF112D4E" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Click="Municipios_Click"/>

                    <Button Content="Dueños" Width="200" Height="45" Margin="0,10,0,0"
                            Background="#FF112D4E" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Click="Dueños_Click"/>

                    <Button Content="Vehículos" Width="200" Height="45" Margin="0,10,0,0"
                            Background="#FF112D4E" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Click="Vehiculos_Click"/>

                    <Button Content="Agentes" Width="200" Height="45" Margin="0,10,0,0"
                            Background="#FF112D4E" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Click="Agentes_Click"/>

                    <Button Content="Tipos de Multa" Width="200" Height="45" Margin="0,10,0,0"
                            Background="#FF112D4E" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Click="TiposMulta_Click"/>

                    <Button Content="Multas" Width="200" Height="45" Margin="0,10,0,0"
                            Background="#FF112D4E" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Click="Multas_Click"/>

                    <Button Content="Pagos" Width="200" Height="45" Margin="0,10,0,0"
                            Background="#FF112D4E" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Click="Pagos_Click"/>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <TextBlock Grid.Row="2" Text="© 2025 Proyecto de Multas - C#"
                   Foreground="White"
                   FontSize="12"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
    </Grid>
</Window>