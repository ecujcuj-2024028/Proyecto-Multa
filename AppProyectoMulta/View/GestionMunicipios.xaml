<Window x:Class="AppProyectoMulta.View.GestionMunicipios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Multas - Gestión de Municipios" 
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#FF0D1B2A">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF0D1B2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF112D4E"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="Button" x:Key="CrudButton">
            <Setter Property="Background" Value="#FF112D4E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF112D4E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnRegresar" Grid.Column="0" 
                        Content="&lt; Regresar al Menú" 
                        Background="Transparent" 
                        Foreground="White"
                        BorderBrush="Transparent"
                        FontSize="14" FontWeight="Bold"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Click="BtnRegresar_Click"/>

                <TextBlock Grid.Column="1" Text="Gestión de Municipios"
                           Foreground="White" FontSize="22"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF112D4E" CornerRadius="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="Datos del Municipio" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

                    <TextBlock Text="ID Municipio:"/>
                    <TextBox x:Name="txtId" IsReadOnly="True" Background="#FF0D1B2A" Text=" (Automático) "/>

                    <TextBlock Text="Nombre:"/>
                    <TextBox x:Name="txtNombre" />

                    <StackPanel Margin="0,25,0,0">
                        <Button x:Name="btnNuevo" Content="Limpiar campo" Style="{StaticResource CrudButton}" Click="BtnNuevo_Click" Width="120"/>
                        <Button x:Name="btnGuardar" Content="Guardar" Style="{StaticResource CrudButton}" Click="BtnGuardar_Click" Width="119"/>
                        <Button x:Name="btnEliminar" Content="Eliminar" Style="{StaticResource CrudButton}" Click="BtnEliminar_Click" Width="121"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="15,0,0,0" Background="#FF112D4E" CornerRadius="5" Padding="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Buscar por ID:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>

                        <TextBox x:Name="txtBuscarId" Width="100" TextChanged="txtBuscarId_TextChanged"/>

                        <Button x:Name="btnBuscar" Content="Buscar" 
                                Style="{StaticResource CrudButton}" 
                                Width="80" Height="30" Margin="5,0,0,0"
                                Click="BtnBuscar_Click"/>

                        <Button x:Name="btnMostrarTodos" Content="Mostrar Todos" 
                                Style="{StaticResource CrudButton}" 
                                Width="110" Height="30" Margin="5,0,0,0"
                                Click="BtnMostrarTodos_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="dataGridMunicipios" 
                              Grid.Row="1"
                              AutoGenerateColumns="False" 
                              Background="Transparent"
                              Foreground="White"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionChanged="DataGridMunicipios_SelectionChanged"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#1AFFFFFF">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF0D1B2A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#FF1B263B"/>
                                        <Setter Property="BorderBrush" Value="#FF4A90E2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2AFFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF1B263B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdMunicipio}" Width="80"/>
                            <DataGridTextColumn Header="Nombre del Municipio" Binding="{Binding NombreMunicipio}" Width="*"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>
            </Border>

        </Grid>

        <TextBlock Grid.Row="2" Text="© 2025 Proyecto de Multas - C#"
                   Foreground="White" FontSize="12"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
    </Grid>
</Window>